<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only: builds the three services in one command (`mvn verify` from the repository root).
  Each service is a standalone Spring Boot project with its own parent and can also be built on its own.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.epam.gym</groupId>
    <artifactId>gym-platform</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>discovery-server</module>
        <module>trainer-workload-service</module>
        <module>gym-crm</module>
    </modules>

    <profiles>
        <profile>
            <!-- mvn verify -Pintegration-tests: also runs the Cucumber integration tests on the Compose stack -->
            <id>integration-tests</id>
            <modules>
                <module>integration-tests</module>
            </modules>
        </profile>
    </profiles>
</project>
