# Copy to .env (git-ignored) and adjust. Docker Compose reads it automatically at startup.
DB_NAME=gym_crm
DB_USERNAME=gym_user
DB_PASSWORD=change_me
# Base64 key (>= 256 bits) that signs the user JWT tokens. Generate one with: openssl rand -base64 32
JWT_SECRET=change_me
# A different Base64 key (>= 256 bits), shared by Gym CRM and the Trainer Workload service, that signs the
# service-to-service tokens. Generate one with: openssl rand -base64 32
SERVICE_JWT_SECRET=change_me
# ActiveMQ broker user and password (the web console login is admin with the same password)
ACTIVEMQ_USER=gym
ACTIVEMQ_PASSWORD=change_me
# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Host ports the services are published on
APP_PORT=8080
WORKLOAD_PORT=8081
EUREKA_PORT=8761
ACTIVEMQ_CONSOLE_PORT=8161
