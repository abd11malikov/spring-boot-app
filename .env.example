# Copy to .env (git-ignored) and adjust. Docker Compose reads it automatically at startup.
DB_NAME=gym_crm
DB_USERNAME=gym_user
DB_PASSWORD=change_me
# Base64 key (>= 256 bits) that signs the JWT tokens. Generate one with: openssl rand -base64 32
JWT_SECRET=change_me
# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Host port the application is published on
APP_PORT=8080
